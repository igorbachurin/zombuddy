{
  "name": "zombuddy",
  "private": true,
  "version": "0.1.0",
  "description": "Offline-first Project Zomboid run companion for Build 42.20.",
  "repository": {
    "type": "git",
    "url": "https://github.com/igorbachurin/zombuddy.git"
  },
  "bugs": {
    "url": "https://github.com/igorbachurin/zombuddy/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:catalog": "node --import tsx scripts/validate-catalog.ts",
    "generate:catalog": "node --import tsx scripts/generate-catalog.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run validate:catalog && npm run build"
  },
  "overrides": {
    "filelist": "2.0.2",
    "glob": "13.0.6"
  },
  "dependencies": {
    "dexie": "^4.2.1",
    "dexie-react-hooks": "^4.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.3.0",
    "jsdom": "^27.4.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
